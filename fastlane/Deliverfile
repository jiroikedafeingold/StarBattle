# Metadata + screenshots only (the binary comes from Xcode Cloud, not here).
#
# DEFAULT SCOPE: only What's New + screenshots. `fastlane/metadata/en-US/` deliberately
# contains ONLY `release_notes.txt` — deliver never changes a field it has no file for, so
# the App Store name, subtitle, description, keywords, promo text and URLs are left exactly
# as they are in App Store Connect. Add a field's .txt file only if you want it uploaded.
app_identifier("com.jirofeingold.CherryBomb")
skip_binary_upload(true)
overwrite_screenshots(true)
submit_for_review(false)      # upload only; you review + submit in App Store Connect
force(true)                   # don't open the HTML preview / prompt
run_precheck_before_submit(false)
